---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  heading?: string;
  subheading?: string;
}

const { title, description, heading, subheading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="content-page">
    {(heading || subheading) && (
      <div class="content-hero">
        <div class="container">
          {heading && <h1>{heading}</h1>}
          {subheading && <p class="subheading">{subheading}</p>}
        </div>
      </div>
    )}
    <div class="content-body container">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  /* All content-page styles now live in global.css — no local overrides needed */
  .content-body {
    max-width: 800px;
  }
</style>
