---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  heading?: string;
  subheading?: string;
}

const { title, description, heading, subheading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="content-page">
    {(heading || subheading) && (
      <div class="content-hero">
        <div class="container">
          {heading && <h1>{heading}</h1>}
          {subheading && <p class="subheading">{subheading}</p>}
        </div>
      </div>
    )}
    <div class="content-body container">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .content-page {
    min-height: 100vh;
    padding-bottom: var(--space-3xl);
  }

  .content-hero {
    padding-top: calc(72px + var(--space-3xl));
    padding-bottom: var(--space-2xl);
    text-align: center;
  }

  .content-hero h1 {
    margin-bottom: var(--space-md);
  }

  .subheading {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 55ch;
    margin-inline: auto;
  }

  .content-body {
    max-width: min(800px, calc(var(--content-max)));
  }
</style>
