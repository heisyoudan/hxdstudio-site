---
import BaseLayout from '../layouts/BaseLayout.astro';
import Orb from '../components/react/Orb.tsx';
import { site } from '../data/site.ts';
import { p } from '../utils/url.ts';
const title = 'DANSHARI — Quiet Mac software';
---

<BaseLayout title={title} description={site.description}>

<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     01  HERO
     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section class="hero" id="hero">
  <div class="orb-wrap">
    <Orb client:load hue={0} hoverIntensity={0.35} backgroundColor="#0A0A0A" />
  </div>

  <!-- gradient mask: make text readable against bright Orb areas -->
  <div class="orb-mask" aria-hidden="true"></div>

  <div class="hero-body container">
    <p class="eyebrow">Independent Mac Software Studio</p>

    <h1 class="display">
      <span class="display-line">REMOVE</span>
      <span class="display-line">THE NOISE.</span>
    </h1>

    <p class="hero-sub">
      Quiet software. Less to think about.
    </p>

    <a class="cta-link" href={p('/work/')}>
      <span>View the work</span>
      <span class="cta-arrow" aria-hidden="true">↓</span>
    </a>
  </div>

  <div class="hero-corner" aria-hidden="true">
    <span>TOKYO · JAPAN</span>
    <span>EST. 2026</span>
  </div>
</section>

<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     02  PHILOSOPHY  (scroll-driven)
     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section class="philo" id="philo" aria-label="Our philosophy">
  <div class="philo-track">
    <!-- sticky stage -->
    <div class="philo-stage">
      <div class="container philo-inner">
        <div class="more-col">
          <div class="more-item"><span class="more-text">MORE FEATURES</span><span class="strike" aria-hidden="true"></span></div>
          <div class="more-item"><span class="more-text">MORE SETTINGS</span><span class="strike" aria-hidden="true"></span></div>
          <div class="more-item"><span class="more-text">MORE OPTIONS</span><span class="strike" aria-hidden="true"></span></div>
          <div class="more-item"><span class="more-text">MORE COMPLEXITY</span><span class="strike" aria-hidden="true"></span></div>
        </div>
        <div class="less-col">
          <p class="less-word">LESS.</p>
          <p class="less-sub">Every feature must earn its place.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     03  IDENTITY
     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
<section class="identity">
  <div class="container">
    <p class="identity-name">DANSHARI / 断捨離</p>
    <p class="identity-line">Software should ask less of you.</p>
    <p class="identity-meta">Tokyo · Japan · 2026</p>
  </div>
</section>

</BaseLayout>

<style>

/* ── Shared ──────────────────────────────────────── */
.label{font-size:.65rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--t3)}

/* ════ HERO ════════════════════════════════════════ */
.hero{
  position:relative;
  height:100svh;min-height:600px;
  background:var(--bg);
  overflow:hidden;
}

.orb-wrap{
  position:absolute;inset:0;z-index:0;
}
.orb-wrap :global(.orb-container){width:100%;height:100%}

/* radial gradient that keeps text zone dark */
.orb-mask{
  position:absolute;inset:0;z-index:1;pointer-events:none;
  background:radial-gradient(ellipse 70% 80% at 70% 50%, transparent 30%, rgba(10,10,10,.7) 80%);
}

.hero-body{
  position:relative;z-index:2;
  height:100%;
  display:flex;flex-direction:column;justify-content:center;
  padding-top:64px;
  padding-bottom:80px;
  gap:0;
  /* pass mouse events through to the Orb canvas below */
  pointer-events:none;
}

.eyebrow{
  font-size:.68rem;font-weight:700;
  letter-spacing:.16em;text-transform:uppercase;
  color:rgba(244,243,239,.32);
  margin-bottom:32px;
}

.display{
  display:flex;flex-direction:column;
  line-height:.88;
  margin-bottom:36px;
}
.display-line{
  display:block;
  font-size:clamp(4.5rem,13vw,11rem);
  font-weight:900;
  letter-spacing:-.04em;
  color:rgba(244,243,239,.97);
  /* subtle text shadow for readability on bright Orb spots */
  text-shadow:0 2px 40px rgba(0,0,0,.5);
}

.hero-sub{
  font-size:clamp(.78rem,1.1vw,.92rem);
  font-weight:500;letter-spacing:.03em;
  color:rgba(244,243,239,.48);
  margin-bottom:40px;
}

.cta-link{
  display:inline-flex;align-items:center;gap:10px;
  font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:rgba(244,243,239,.7);
  text-decoration:none;
  padding-bottom:3px;
  border-bottom:1px solid rgba(244,243,239,.3);
  width:fit-content;
  pointer-events:auto; /* restore click target inside pointer-events:none container */
  transition:color var(--fast),border-color var(--fast);
}
.cta-link:hover{color:rgba(244,243,239,.96);border-color:rgba(244,243,239,.7)}

.cta-arrow{
  display:inline-block;
  animation:bob 2.6s ease-in-out infinite;
}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}

.hero-corner{
  position:absolute;bottom:36px;right:var(--px);z-index:2;
  display:flex;flex-direction:column;align-items:flex-end;gap:4px;
}
.hero-corner span{
  font-size:.6rem;font-weight:600;letter-spacing:.1em;
  color:rgba(244,243,239,.22);
}

/* ════ PHILOSOPHY ══════════════════════════════════ */
/* 300vh scroll runway gives sticky stage plenty of scroll range */
.philo{position:relative;height:300vh}

.philo-track{
  position:sticky;top:0;
  height:100vh;
  border-top:1px solid var(--rule);
  border-bottom:1px solid var(--rule);
}

.philo-stage{
  height:100%;
  display:flex;align-items:center;
}

.philo-inner{
  display:grid;
  grid-template-columns:1fr auto;
  gap:clamp(40px,6vw,100px);
  align-items:center;
  width:100%;
}

.more-col{display:flex;flex-direction:column;gap:6px}

.more-item{
  position:relative;
  display:inline-flex;align-items:center;
  overflow:hidden;
}
.more-text{
  font-size:clamp(1.5rem,3.5vw,3rem);
  font-weight:800;letter-spacing:-.02em;line-height:1.1;
  color:rgba(244,243,239,.35);
  transition:color var(--slow) var(--ease);
  white-space:nowrap;
}
.strike{
  position:absolute;left:0;top:50%;
  height:1.5px;background:rgba(244,243,239,.55);
  width:0;
  transition:width var(--slow) var(--ease);
}

.more-item.struck .more-text{color:rgba(244,243,239,.12)}
.more-item.struck .strike{width:100%}

.less-col{
  display:flex;flex-direction:column;gap:10px;
  text-align:right;
  flex-shrink:0;
}
.less-word{
  font-size:clamp(2.5rem,7vw,7rem);
  font-weight:900;letter-spacing:-.04em;line-height:.9;
  color:rgba(244,243,239,.96);
  opacity:0;transform:translateX(20px) scale(.95);
  transition:opacity var(--slow) var(--ease),transform var(--slow) cubic-bezier(.34,1.56,.64,1);
}
.less-sub{
  font-size:clamp(.62rem,.9vw,.78rem);
  font-weight:600;letter-spacing:.07em;
  color:rgba(244,243,239,.32);
  opacity:0;transform:translateX(12px);
  transition:opacity var(--slow) var(--ease) .2s,transform var(--slow) var(--ease) .2s;
}
.less-word.show,.less-sub.show{opacity:1;transform:none}

/* ════ WORK CTA ═══════════════════════════════════ */
.work-sec{
  padding-block:clamp(56px,7vw,96px);
  border-top:1px solid var(--rule);
}

.work-cta{
  display:flex;
  align-items:baseline;
  gap:24px;
  text-decoration:none;
  color:inherit;
  width:fit-content;
}

.work-cta-label{
  font-size:.62rem;font-weight:700;letter-spacing:.16em;
  color:var(--t3);flex-shrink:0;
}

.work-cta-text{
  font-size:clamp(1.8rem,4vw,3.2rem);
  font-weight:900;letter-spacing:-.02em;line-height:1;
  color:var(--t1);
  transition:transform var(--mid) var(--ease);
}

.work-cta-arrow{
  font-size:1.2rem;
  color:var(--t3);
  transition:transform var(--mid) var(--ease),color var(--fast);
}

.work-cta:hover .work-cta-text{transform:translateX(8px)}
.work-cta:hover .work-cta-arrow{
  transform:translate(6px,-6px);
  color:var(--t1);
}

/* ════ IDENTITY ════════════════════════════════════ */
.identity{
  padding-block:clamp(64px,8vw,120px);
  border-top:1px solid var(--rule);
}
.identity-name{
  font-size:clamp(.8rem,1.4vw,1rem);
  font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:var(--t2);margin-bottom:18px;
}
.identity-line{
  font-size:clamp(1.2rem,2.5vw,1.8rem);
  font-weight:700;letter-spacing:-.01em;
  color:var(--t1);margin-bottom:14px;
}
.identity-meta{
  font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  color:var(--t3);
}

/* ════ Responsive ══════════════════════════════════ */
@media(max-width:768px){
  .philo-inner{grid-template-columns:1fr;gap:36px}
  .less-col{text-align:left}
  .work-row{grid-template-columns:36px 1fr 28px;gap:12px}
  .work-type,.work-year{display:none}
}
</style>

<script>
// ─── Philosophy: scroll-linked strikethrough ─────────────
const philo   = document.getElementById('philo') as HTMLElement | null;
const items   = document.querySelectorAll<HTMLElement>('.more-item');
const lessW   = document.querySelector<HTMLElement>('.less-word');
const lessSub = document.querySelector<HTMLElement>('.less-sub');

let raf = false;
function updatePhilo() {
  raf = false;
  if (!philo) return;
  const r   = philo.getBoundingClientRect();
  const vh  = window.innerHeight;
  // progress: 0 = section enters, 1 = section exits
  const p   = Math.max(0, Math.min(1, (vh - r.top) / (vh + philo.offsetHeight * .6)));

  items.forEach((el, i) => {
    el.classList.toggle('struck', p > 0.08 + i * 0.14);
  });
  lessW?.classList.toggle('show',  p > 0.68);
  lessSub?.classList.toggle('show',p > 0.74);
}

window.addEventListener('scroll', () => {
  if (!raf) { raf = true; requestAnimationFrame(updatePhilo); }
}, { passive: true });
updatePhilo();
</script>
