---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.ts';
import { apps } from '../../data/apps.ts';
import { p } from '../../utils/url.ts';
const title = `Work | ${site.name}`;
---

<BaseLayout title={title} description="All work from DANSHARI.">
<section class="w-page">
  <div class="container">

    <div class="w-header">
      <p class="w-eyebrow">DANSHARI / WORK</p>
      <h1 class="w-title">All work.</h1>
      <p class="w-sub">Apps and tools made to reduce friction.</p>
    </div>

    <div class="w-filters">
      <span class="filter active">ALL</span>
      <span class="filter">APPS</span>
    </div>

    <ul class="w-list" role="list">
      {apps.map((app, i) => (
        <li class="w-item">
          <a href={p(`/work/${app.slug}/`)} class="w-row">
            <span class="w-num">0{i + 1}</span>
            <span class="w-info">
              <span class="w-name">{app.name.toUpperCase()}</span>
              <span class="w-desc">{app.tagline}</span>
            </span>
            <span class="w-tag">APP</span>
            <span class="w-yr">2026</span>
            <span class="w-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="w-note">More in development.</p>

  </div>
</section>
</BaseLayout>

<style>
.w-page{
  min-height:100vh;
  padding-top:calc(64px + clamp(48px,7vw,100px));
  padding-bottom:clamp(80px,10vw,160px);
}

.w-header{margin-bottom:clamp(40px,5vw,64px)}

.w-eyebrow{
  font-size:.65rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
  color:var(--t3);margin-bottom:20px;
}
.w-title{
  font-size:clamp(2.4rem,6vw,5rem);font-weight:900;letter-spacing:-.03em;
  color:var(--t1);line-height:.95;margin-bottom:16px;
}
.w-sub{font-size:.9rem;color:var(--t2);max-width:44ch}

.w-filters{
  display:flex;gap:8px;margin-bottom:48px;
}
.filter{
  font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  padding:6px 14px;border:1px solid var(--rule);border-radius:100px;
  color:var(--t3);cursor:default;
}
.filter.active{border-color:var(--rule-2);color:var(--t1)}

.w-list{list-style:none}

.w-row{
  display:grid;
  grid-template-columns:52px 1fr auto auto 28px;
  align-items:center;gap:24px;
  padding:28px 0;
  border-top:1px solid var(--rule);
  text-decoration:none;color:inherit;
  transition:background var(--fast);
}
.w-row:hover{background:var(--surface);padding-inline:12px;margin-inline:-12px}

.w-num{font-size:.68rem;font-weight:700;letter-spacing:.08em;color:var(--t3)}

.w-info{display:flex;flex-direction:column;gap:5px}

.w-name{
  font-size:clamp(1.6rem,3.5vw,2.8rem);
  font-weight:900;letter-spacing:-.02em;line-height:1;
  color:var(--t1);
  transition:transform var(--mid) var(--ease);
}
.w-row:hover .w-name{transform:translateX(8px)}

.w-desc{font-size:.78rem;color:var(--t2);max-width:50ch}

.w-tag{
  font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--t3);border:1px solid var(--rule);padding:4px 10px;border-radius:100px;
}
.w-yr{font-size:.68rem;font-weight:600;letter-spacing:.06em;color:var(--t3)}

.w-arrow{
  font-size:.9rem;color:var(--t3);
  transition:transform var(--mid) var(--ease),color var(--fast);
}
.w-row:hover .w-arrow{transform:translate(4px,-4px);color:var(--t1)}

.w-list li:last-child .w-row{border-bottom:1px solid var(--rule)}

.w-note{
  margin-top:20px;padding-top:16px;
  font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
  color:var(--t3);border-top:1px solid var(--rule);
}

@media(max-width:768px){
  .w-row{grid-template-columns:36px 1fr 24px;gap:12px}
  .w-tag,.w-yr{display:none}
}
</style>
