---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.ts';
import { getApp } from '../../data/apps.ts';
import { p } from '../../utils/url.ts';
const vortex = getApp('vortex');
if (!vortex) throw new Error('Vortex not found');
const title = `Vortex | ${site.name}`;
---

<BaseLayout title={title} description={vortex.tagline} ogImage={vortex.posters[0]}>

<!-- ── Breadcrumb nav ──────────────────────────── -->
<div class="breadcrumb container">
  <a href={p('/')}>DANSHARI</a>
  <span>/</span>
  <a href={p('/work/')}>WORK</a>
  <span>/</span>
  <span>001</span>
</div>

<!-- ── Hero ────────────────────────────────────── -->
<section class="vx-hero">
  <div class="container vx-hero-inner">
    <div class="vx-hero-text">
      <div class="vx-id">
        <img src={p(vortex.icon)} alt="Vortex app icon"
             class="vx-icon" width="72" height="72" loading="eager" />
        <div>
          <p class="vx-label">APP / FILE ORGANIZATION</p>
          <h1 class="vx-name">VORTEX</h1>
        </div>
      </div>

      <h2 class="vx-headline">
        Take control of your Downloads<br />from the menu bar.
      </h2>

      <p class="vx-desc">
        Vortex helps you see, organize, move, archive, and restore
        downloaded files — without repeatedly opening Finder.
      </p>

      <div class="vx-cta">
        {vortex.appStoreUrl ? (
          <a class="btn-primary" href={vortex.appStoreUrl}
             target="_blank" rel="noopener noreferrer">
            Download on the App Store ↗
          </a>
        ) : (
          <span class="btn-soon">Coming soon to the Mac App Store</span>
        )}
        <a class="btn-ghost" href={p('/support/vortex/')}>Support &amp; FAQ</a>
      </div>
    </div>

    <figure class="vx-hero-img">
      <img src={p(vortex.posters[0])}
           alt="Vortex — see and organize downloads from the menu bar"
           width="600" height="450" loading="eager" fetchpriority="high" />
    </figure>
  </div>
</section>

<!-- ── Feature chapters ─────────────────────────── -->
<div class="vx-chapters">
  {vortex.featureDetails.map((f, i) => (
    <section class={`vx-chapter ${i % 2 === 1 ? 'vx-flip' : ''}`}>
      <div class="container vx-chapter-inner">
        <figure class="vx-ch-img reveal">
          <img src={p(f.poster)} alt={f.title}
               width="640" height="480" loading="lazy" />
        </figure>
        <div class="vx-ch-body reveal">
          <p class="vx-ch-num">0{i + 1}</p>
          <h3 class="vx-ch-title">{f.title}</h3>
          <p class="vx-ch-desc">{f.description}</p>
          <ul class="vx-tags">
            {f.tags.map(t => <li>{t}</li>)}
          </ul>
        </div>
      </div>
    </section>
  ))}
</div>

<!-- ── Bottom CTA ───────────────────────────────── -->
<section class="vx-bottom">
  <div class="container">
    <p class="vx-b-label">DANSHARI / VORTEX / 001</p>
    <h2 class="vx-b-title">Your Downloads, taken care of.</h2>
    <p class="vx-b-sub">Exclusively on the Mac App Store.</p>
    {vortex.appStoreUrl ? (
      <a class="btn-primary" href={vortex.appStoreUrl}
         target="_blank" rel="noopener noreferrer">
        Download on the App Store ↗
      </a>
    ) : (
      <span class="btn-soon">Coming soon to the Mac App Store</span>
    )}

    <div class="vx-b-links">
      <a href={p('/support/vortex/')}>Support</a>
      <span>·</span>
      <a href={p('/privacy/vortex/')}>Privacy</a>
      <span>·</span>
      <a href={p('/work/')}>All work</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
/* ── Breadcrumb ──────────────────────────────────── */
.breadcrumb{
  display:flex;align-items:center;gap:10px;
  padding-top:calc(64px + 24px);padding-bottom:0;
  font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--t3);
}
.breadcrumb a{color:var(--t3);transition:color var(--fast)}
.breadcrumb a:hover{color:var(--t1)}
.breadcrumb span{color:var(--rule-2)}

/* ── Hero ────────────────────────────────────────── */
.vx-hero{
  padding-top:clamp(32px,4vw,56px);
  padding-bottom:clamp(64px,8vw,120px);
  border-bottom:1px solid var(--rule);
}
.vx-hero-inner{
  display:grid;grid-template-columns:1fr 1fr;
  gap:clamp(40px,6vw,96px);align-items:center;
}

.vx-id{display:flex;align-items:center;gap:18px;margin-bottom:28px}
.vx-icon{border-radius:18px;flex-shrink:0}
.vx-label{font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--t3);margin-bottom:4px}
.vx-name{font-size:1.1rem;font-weight:900;letter-spacing:.14em;color:var(--t1)}

.vx-headline{
  font-size:clamp(1.7rem,3.2vw,2.8rem);
  font-weight:800;letter-spacing:-.02em;line-height:1.1;
  color:var(--t1);margin-bottom:20px;
}

.vx-desc{font-size:.9rem;color:var(--t2);line-height:1.72;max-width:46ch;margin-bottom:32px}

.vx-cta{display:flex;align-items:center;gap:20px;flex-wrap:wrap}

.btn-primary{
  display:inline-flex;align-items:center;gap:6px;
  padding:11px 22px;
  background:var(--t1);color:var(--bg);
  font-size:.72rem;font-weight:700;letter-spacing:.06em;
  border-radius:2px;text-decoration:none;
  transition:opacity var(--fast);
}
.btn-primary:hover{opacity:.82}

.btn-soon{font-size:.75rem;color:var(--t3);font-style:italic}

.btn-ghost{
  font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
  color:var(--t2);text-decoration:none;
  padding-bottom:2px;border-bottom:1px solid var(--rule);
  transition:color var(--fast),border-color var(--fast);
}
.btn-ghost:hover{color:var(--t1);border-color:var(--t1)}

.vx-hero-img img{
  width:100%;height:auto;
  border-radius:12px;
  border:1px solid var(--rule-2);
  box-shadow:0 32px 80px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.04);
}

/* ── Chapters ────────────────────────────────────── */
.vx-chapter{
  padding-block:clamp(64px,9vw,120px);
  border-bottom:1px solid var(--rule);
}
.vx-chapter-inner{
  display:grid;grid-template-columns:1fr 1fr;
  gap:clamp(40px,6vw,96px);align-items:center;
}

/* flip even chapters */
.vx-flip .vx-ch-img{order:2}

.vx-ch-img img{
  width:100%;height:auto;
  border-radius:12px;
  border:1px solid var(--rule-2);
  box-shadow:0 24px 60px rgba(0,0,0,.5);
}

.vx-ch-num{
  font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:var(--accent);margin-bottom:14px;
}
.vx-ch-title{
  font-size:clamp(1.5rem,2.8vw,2.2rem);
  font-weight:800;letter-spacing:-.02em;line-height:1.1;
  color:var(--t1);margin-bottom:16px;
}
.vx-ch-desc{
  font-size:.9rem;color:var(--t2);line-height:1.72;
  max-width:44ch;margin-bottom:22px;
}
.vx-tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none}
.vx-tags li{
  font-size:.65rem;font-weight:600;letter-spacing:.04em;
  color:var(--t2);
  padding:5px 12px;border:1px solid var(--rule);border-radius:100px;
}

/* ── Scroll reveal ───────────────────────────────── */
.reveal{
  opacity:0;transform:translateY(28px);
  transition:opacity 600ms var(--ease),transform 600ms var(--ease);
}
.reveal.in{opacity:1;transform:none}

/* ── Bottom CTA ──────────────────────────────────── */
.vx-bottom{
  padding-block:clamp(80px,10vw,140px);
  text-align:center;
}
.vx-b-label{
  font-size:.65rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:var(--t3);margin-bottom:20px;
}
.vx-b-title{
  font-size:clamp(1.8rem,4vw,3.4rem);font-weight:800;letter-spacing:-.02em;
  color:var(--t1);line-height:1.05;margin-bottom:14px;
}
.vx-b-sub{font-size:.85rem;color:var(--t2);margin-bottom:32px}
.vx-b-links{
  display:flex;align-items:center;justify-content:center;gap:10px;
  margin-top:28px;
  font-size:.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
  color:var(--t3);
}
.vx-b-links a{color:var(--t3);transition:color var(--fast)}
.vx-b-links a:hover{color:var(--t1)}

/* ── Responsive ──────────────────────────────────── */
@media(max-width:900px){
  .vx-hero-inner{grid-template-columns:1fr}
  .vx-hero-img{order:-1}
  .vx-chapter-inner{grid-template-columns:1fr}
  .vx-flip .vx-ch-img{order:0}
}
@media(prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
}
</style>

<script>
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  });
}, { threshold: 0.12 });
document.querySelectorAll<HTMLElement>('.reveal').forEach(el => io.observe(el));
</script>
