---
import ContentLayout from '../layouts/ContentLayout.astro';
import { site } from '../data/site.ts';

const title = `Contact | ${site.name}`;
const description = 'Get in touch with DANSHARI.';
---

<ContentLayout title={title} description={description} heading="Contact DANSHARI">
  <div class="contact-body">
    <p class="lead">
      For product support, bug reports, and general inquiries, contact:
    </p>

    <div class="contact-card">
      <p class="email-label">EMAIL</p>
      <p class="email-address">{site.supportEmail}</p>
      <a
        href={`mailto:${site.supportEmail}`}
        class="email-cta"
        id="email-cta"
        data-email={site.supportEmail}
      >
        <span class="cta-default">EMAIL DANSHARI →</span>
        <span class="cta-copied" aria-hidden="true">COPIED ✓</span>
      </a>
    </div>

    <p class="note">We aim to respond within one to two business days.</p>
  </div>
</ContentLayout>

<style>
  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 480px;
    margin-top: 40px;
  }

  .lead {
    font-size: 0.9rem;
    color: var(--t2);
    line-height: 1.7;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 7px;
  }

  .email-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--t3);
  }

  .email-address {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--t1);
    user-select: all;
  }

  .email-cta {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--t2);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    width: fit-content;
    transition: color 150ms, border-color 150ms;
    position: relative;
  }
  .email-cta:hover { color: var(--t1); border-color: rgba(255,255,255,0.5); }

  .cta-copied {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity 150ms;
    color: var(--accent);
    pointer-events: none;
  }
  /* js adds .did-copy */
  .email-cta.did-copy .cta-default { opacity: 0; }
  .email-cta.did-copy .cta-copied  { opacity: 1; }

  .note {
    font-size: 0.78rem;
    color: var(--t3);
  }
</style>

<script>
  const btn = document.getElementById('email-cta') as HTMLAnchorElement | null;
  btn?.addEventListener('click', () => {
    const email = btn.dataset.email ?? '';
    navigator.clipboard.writeText(email).catch(() => {});
    btn.classList.add('did-copy');
    setTimeout(() => btn.classList.remove('did-copy'), 2000);
    // mailto: fires via the default href — no preventDefault needed
  });
</script>
