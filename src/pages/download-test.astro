---
import { p } from '../utils/url.ts';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Vortex — Connection Test</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }
      body {
        display: grid;
        place-items: center;
        background: #0a0a0a;
        color: #f4f3ef;
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
          "Segoe UI", sans-serif;
      }
      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        text-align: center;
      }
      .vortex-icon {
        width: 72px;
        height: 72px;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      }
      .vortex-name {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      a.btn {
        display: inline-block;
        padding: 16px 40px;
        margin-top: 8px;
        background: #f4f3ef;
        color: #0a0a0a;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        border-radius: 8px;
        text-decoration: none;
        transition: opacity 150ms;
      }
      a.btn:hover {
        opacity: 0.85;
      }
    </style>
  </head>
  <body>
    <main>
      <img class="vortex-icon" src={p('/brand/vortex-app-icon.png')} alt="Vortex" width="72" height="72" />
      <p class="vortex-name">Vortex</p>
      <a class="btn" href={p('/files/test-image.png')} download>
        Download Test Image
      </a>
    </main>
  </body>
</html>
