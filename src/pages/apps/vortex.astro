---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.ts';
import { getApp } from '../../data/apps.ts';
import { p } from '../../utils/url.ts';

const vortex = getApp('vortex');
if (!vortex) throw new Error('Vortex app not found');

const title = `Vortex | ${site.name}`;
const description = vortex.tagline;
---

<BaseLayout title={title} description={description} ogImage={vortex.posters[0]}>

<!-- ═══ HERO (dark) ═══ -->
<section class="v-hero">
  <div class="container v-hero-inner">
    <div class="v-hero-text">
      <div class="v-app-id">
        <img
          src={p(vortex.icon)}
          alt="Vortex app icon"
          class="v-app-icon"
          width="72"
          height="72"
          loading="eager"
        />
        <h1 class="v-app-name">VORTEX</h1>
      </div>

      <h2 class="v-headline blur-in">
        Take control of your Downloads<br />from the menu bar.
      </h2>

      <p class="v-desc blur-in" style="animation-delay:120ms">
        Vortex helps you see, organize, move, archive, and restore
        downloaded files without repeatedly opening Finder.
      </p>

      <div class="v-cta blur-in" style="animation-delay:240ms">
        {vortex.appStoreUrl ? (
          <a class="btn-store" href={vortex.appStoreUrl}
             target="_blank" rel="noopener noreferrer">
            Download on the App Store ↗
          </a>
        ) : (
          <span class="btn-soon">Coming soon to the Mac App Store</span>
        )}
        <a class="btn-ghost" href={p('/support/vortex/')}>Support &amp; FAQ</a>
      </div>
    </div>

    <div class="v-hero-poster blur-in" style="animation-delay:160ms">
      <div class="v-poster-frame">
        <img
          src={p(vortex.posters[0])}
          alt="Vortex — see and organize downloads from the menu bar"
          width="600"
          height="450"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<!-- ═══ FEATURES (light, alternating) ═══ -->
<section class="v-features">
  {vortex.featureDetails.map((f, i) => (
    <div class="v-feature">
      <div class="container v-feature-inner">
        <figure class="v-feature-media reveal">
          <img
            src={p(f.poster)}
            alt={f.title}
            width="640"
            height="480"
            loading="lazy"
          />
        </figure>
        <div class="v-feature-body reveal">
          <p class="v-feature-index">0{i + 1}</p>
          <h3 class="v-feature-title">{f.title}</h3>
          <p class="v-feature-desc">{f.description}</p>
          <ul class="v-feature-tags" aria-label="Highlights">
            {f.tags.map(t => <li>{t}</li>)}
          </ul>
        </div>
      </div>
    </div>
  ))}
</section>

<!-- ═══ CTA (dark) ═══ -->
<section class="v-bottom">
  <div class="container v-bottom-inner">
    <h2 class="v-bottom-title">Ready to tame your downloads?</h2>
    <p class="v-bottom-sub">Available exclusively on the Mac App Store.</p>
    <div class="v-bottom-cta">
      {vortex.appStoreUrl ? (
        <a class="btn-store" href={vortex.appStoreUrl}
           target="_blank" rel="noopener noreferrer">
          Download on the App Store ↗
        </a>
      ) : (
        <span class="btn-soon">Coming soon to the Mac App Store</span>
      )}
    </div>
  </div>
</section>

</BaseLayout>

<style>

/* ═══ HERO ═══ */
.v-hero {
  background: #0A0A0A;
  padding-top: calc(64px + 72px);
  padding-bottom: 96px;
}

.v-hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

/* blur-to-clear entrance */
.blur-in {
  animation: blur-in 800ms var(--ease-d) both;
}
@keyframes blur-in {
  from { opacity: 0; filter: blur(14px); transform: translateY(16px); }
  to   { opacity: 1; filter: blur(0); transform: translateY(0); }
}

.v-app-id {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 28px;
}

.v-app-icon { border-radius: 16px; flex-shrink: 0; }

.v-app-name {
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: 0.2em;
  color: rgba(244, 243, 239, 0.9);
}

.v-headline {
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.08;
  color: rgba(244, 243, 239, 0.96);
  margin-bottom: 24px;
}

.v-desc {
  font-size: 0.95rem;
  color: rgba(244, 243, 239, 0.55);
  line-height: 1.7;
  max-width: 46ch;
  margin-bottom: 36px;
}

.v-cta {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.btn-store {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 12px 22px;
  background: rgba(244, 243, 239, 0.95);
  color: #0A0A0A;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  border-radius: 2px;
  text-decoration: none;
  transition: opacity var(--dur-s);
}
.btn-store:hover { opacity: 0.82; }

.btn-soon {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: rgba(244, 243, 239, 0.4);
  font-style: italic;
}

.btn-ghost {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: rgba(244, 243, 239, 0.6);
  text-decoration: none;
  padding-bottom: 2px;
  border-bottom: 1px solid rgba(244, 243, 239, 0.3);
  transition: color var(--dur-s), border-color var(--dur-s);
}
.btn-ghost:hover { color: rgba(244, 243, 239, 0.9); border-color: rgba(244, 243, 239, 0.9); }

.v-hero-poster {
  display: flex;
  justify-content: center;
}

.v-poster-frame {
  border-radius: 16px;
  overflow: hidden;
  box-shadow:
    0 0 0 1px rgba(244, 243, 239, 0.08),
    0 40px 90px rgba(0, 0, 0, 0.6);
}
.v-poster-frame img { width: 100%; height: auto; display: block; }

/* ═══ FEATURES ═══ */
.v-feature {
  padding-block: 96px;
  border-bottom: 1px solid var(--border);
}
.v-feature:last-child { border-bottom: none; }

.v-feature-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

/* alternate: even items flip the order */
.v-feature:nth-child(even) .v-feature-inner .v-feature-media {
  order: 2;
}

.v-feature-media img {
  width: 100%;
  height: auto;
  border-radius: 12px;
  border: 1px solid var(--border);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
}

.v-feature-index {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin-bottom: 14px;
}

.v-feature-title {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--ink);
  margin-bottom: 18px;
}

.v-feature-desc {
  font-size: 0.92rem;
  color: var(--ink-2);
  line-height: 1.7;
  max-width: 44ch;
  margin-bottom: 24px;
}

.v-feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
}
.v-feature-tags li {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--ink-2);
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 100px;
}

/* ═══ CTA ═══ */
.v-bottom {
  background: #0A0A0A;
  padding-block: 96px;
}

.v-bottom-inner {
  text-align: center;
}

.v-bottom-title {
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: rgba(244, 243, 239, 0.96);
  margin-bottom: 14px;
}

.v-bottom-sub {
  font-size: 0.85rem;
  color: rgba(244, 243, 239, 0.45);
  margin-bottom: 36px;
}

.v-bottom-cta {
  display: flex;
  justify-content: center;
}

/* ═══ scroll reveal ═══ */
.reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 700ms var(--ease-d), transform 700ms var(--ease-d);
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ═══ Responsive ═══ */
@media (max-width: 900px) {
  .v-hero-inner { grid-template-columns: 1fr; }
  .v-hero-poster { order: -1; }
  .v-feature-inner { grid-template-columns: 1fr; gap: 40px; }
  .v-feature:nth-child(even) .v-feature-inner .v-feature-media { order: 0; }
}

/* ═══ Reduced motion ═══ */
@media (prefers-reduced-motion: reduce) {
  .blur-in { animation: none; }
  .reveal { opacity: 1; transform: none; transition: none; }
}

</style>

<script>
  // ─── scroll reveal ────────────────────────────────────────
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');

  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  revealEls.forEach((el) => io.observe(el));
</script>
