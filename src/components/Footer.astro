---
import { site } from '../data/site.ts';
import { p } from '../utils/url.ts';
---

<footer class="danshari-footer">
  <div class="footer-inner container">

    <div class="footer-brand">
      <div class="footer-logo-wrap">
        <p class="footer-logo">DANSHARI</p>
        <p class="footer-line-1" aria-hidden="true">LESS SOFTWARE.</p>
        <p class="footer-line-2" aria-hidden="true">BETTER SOFTWARE.</p>
      </div>
      <p class="footer-desc">Independent software studio.<br>Small Mac apps. Thoughtful design.</p>
      <a class="footer-email" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <p class="col-label">WORK</p>
        <ul>
          <li><a href={p('/work/')}>All Work</a></li>
          <li><a href={p('/work/vortex/')}>Vortex</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="col-label">SUPPORT</p>
        <ul>
          <li><a href={p('/support/')}>Help Center</a></li>
          <li><a href={p('/contact/')}>Contact</a></li>
          <li><a href={p('/support/vortex/')}>Vortex FAQ</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="col-label">LEGAL</p>
        <ul>
          <li><a href={p('/privacy/vortex/')}>Privacy Policy</a></li>
          <li><a href={p('/privacy/')}>All Policies</a></li>
        </ul>
      </div>
    </div>

  </div>

  <div class="footer-bottom container">
    <p>© {site.copyrightYear} DANSHARI</p>
    <a href="https://github.com/heisyoudan/hxdstudio-site" class="footer-gh" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.419 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
    </a>
  </div>
</footer>

<style>
  .danshari-footer {
    background: var(--dark);
    color: rgba(244,243,239,0.7);
    padding-top: 80px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 80px;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(244,243,239,0.08);
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-logo-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .footer-logo {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: rgba(244,243,239,0.92);
    cursor: default;
    user-select: none;
  }

  .footer-line-1,
  .footer-line-2 {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(244,243,239,0.35);
    transform: translateY(-4px);
    opacity: 0;
    transition: transform var(--dur-m) var(--ease-d), opacity var(--dur-m) var(--ease-d);
    max-height: 0;
    overflow: hidden;
  }

  .footer-logo-wrap:hover .footer-line-1 {
    transform: translateY(0);
    opacity: 1;
    max-height: 24px;
  }

  .footer-logo-wrap:hover .footer-line-2 {
    transform: translateY(0);
    opacity: 1;
    max-height: 24px;
    transition-delay: 240ms;
  }

  .footer-desc {
    font-size: 0.82rem;
    line-height: 1.65;
    color: rgba(244,243,239,0.4);
  }

  .footer-email {
    font-size: 0.78rem;
    color: rgba(244,243,239,0.45);
    letter-spacing: 0.02em;
    transition: color var(--dur-s) var(--ease-d);
  }
  .footer-email:hover { color: rgba(244,243,239,0.85); }

  /* Columns */
  .footer-cols {
    display: flex;
    gap: 56px;
  }

  .footer-col { display: flex; flex-direction: column; gap: 16px; }

  .col-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgba(244,243,239,0.35);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    font-size: 0.82rem;
    color: rgba(244,243,239,0.55);
    transition: color var(--dur-s) var(--ease-d);
  }
  .footer-col a:hover { color: rgba(244,243,239,0.9); }

  .soon {
    font-size: 0.82rem;
    color: rgba(244,243,239,0.25);
    cursor: default;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
  }

  .footer-bottom p {
    font-size: 0.7rem;
    color: rgba(244,243,239,0.3);
    letter-spacing: 0.06em;
  }

  .footer-gh {
    color: rgba(244,243,239,0.3);
    transition: color var(--dur-s) var(--ease-d);
    display: flex;
    align-items: center;
  }
  .footer-gh:hover { color: rgba(244,243,239,0.8); }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .footer-cols { gap: 32px; flex-wrap: wrap; }
  }
</style>
