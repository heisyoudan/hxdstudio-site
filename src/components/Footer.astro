---
import { site } from '../data/site.ts';
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="brand-mark" aria-hidden="true">HXD</span>
        <span>{site.name}</span>
      </a>
      <p class="footer-tagline">{site.tagline}</p>
      <a class="footer-email" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        <li><a href="/apps/vortex/">Apps</a></li>
        <li><a href="/support/">Support</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-bottom container">
    <p>© {site.copyrightYear} {site.name}</p>
    <p>Built with care for macOS.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
    position: relative;
    z-index: 1;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
  }
  .footer-logo:hover { text-decoration: none; }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: linear-gradient(135deg, rgba(240,82,167,0.14), rgba(115,119,255,0.14));
    border: 1px solid rgba(180, 160, 220, 0.22);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-tagline {
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  .footer-email {
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer-email:hover { color: var(--text-primary); text-decoration: none; }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer-nav a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer-nav a:hover { color: var(--text-primary); text-decoration: none; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
  }

  .footer-bottom p {
    color: var(--text-tertiary);
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .footer-inner { flex-direction: column; gap: var(--space-xl); }
    .footer-bottom { flex-direction: column; gap: var(--space-sm); }
  }
</style>
