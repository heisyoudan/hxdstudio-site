---
import { site } from '../data/site.ts';
import { p } from '../utils/url.ts';
---

<header class="hdr" id="site-header">
  <div class="hdr-inner container">

    <a class="hdr-logo" href={p('/')} aria-label="DANSHARI — Home">
      <span class="hdr-logo-letters">
        DAN<span class="lg-seg">SHA</span><span class="lg-seg">RI</span>
      </span>
      <span class="hdr-logo-ja" aria-hidden="true">断 捨 離</span>
    </a>

    <button class="hdr-menu-btn" id="menu-open" aria-label="Open menu"
            aria-expanded="false" aria-controls="menu-overlay">
      <span class="menu-btn-line"></span>
      <span class="menu-btn-label">MENU</span>
    </button>

  </div>
</header>

<!-- ═══════ Fullscreen menu overlay ═══════ -->
<div class="menu-overlay" id="menu-overlay" aria-hidden="true">
  <div class="menu-top container">
    <span class="menu-wordmark">DANSHARI</span>
    <button class="menu-close" id="menu-close" aria-label="Close menu">CLOSE</button>
  </div>

  <nav class="menu-nav container" aria-label="Fullscreen navigation">
    <a class="menu-link" href={p('/work/')} data-split>WORK</a>
    <a class="menu-link" href={p('/contact/')} data-split>ABOUT</a>
    <a class="menu-link" href={p('/support/')} data-split>SUPPORT</a>
    <a class="menu-link" href={p('/privacy/')} data-split>PRIVACY</a>
    <a class="menu-link" href={`mailto:${site.supportEmail}`} data-split>CONTACT</a>
  </nav>

  <div class="menu-foot container">
    <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
    <span>TOKYO · JAPAN</span>
  </div>
</div>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 90;
    height: 64px;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-s) var(--ease-d),
                background var(--dur-s) var(--ease-d);
  }

  .hdr.scrolled {
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgba(244, 243, 239, 0.08);
  }

  .hdr-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── logo ── */
  .hdr-logo {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    line-height: 1;
    overflow: hidden;
    color: rgba(244, 243, 239, 0.88);
  }
  .hdr-logo-letters {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    display: flex;
    gap: 0;
    transition: gap var(--dur-m) var(--ease-d);
  }
  .hdr-logo:hover .hdr-logo-letters { gap: 7px; }
  .hdr-logo-ja {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: rgba(244, 243, 239, 0.35);
    transform: translateY(-6px);
    opacity: 0;
    transition: transform var(--dur-m) var(--ease-d), opacity var(--dur-m) var(--ease-d);
    pointer-events: none;
  }
  .hdr-logo:hover .hdr-logo-ja { transform: translateY(0); opacity: 1; }

  /* ── menu button ── */
  .hdr-menu-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(244, 243, 239, 0.9);
    font-family: var(--font);
    padding: 6px 0;
  }
  .menu-btn-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    transition: opacity var(--dur-s) var(--ease-d);
  }
  .menu-btn-line {
    width: 22px;
    height: 1.5px;
    background: rgba(244, 243, 239, 0.9);
    position: relative;
    transition: transform var(--dur-s) var(--ease-d);
  }
  .menu-btn-line::before,
  .menu-btn-line::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: rgba(244, 243, 239, 0.9);
    transition: transform var(--dur-s) var(--ease-d);
  }
  .menu-btn-line::before { top: -6px; }
  .menu-btn-line::after  { top: 6px; }
  .hdr-menu-btn:hover .menu-btn-line { transform: scaleX(0.7); }

  /* ═══ overlay ═══ */
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #0A0A0A;
    color: rgba(244, 243, 239, 0.9);
    display: flex;
    flex-direction: column;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 500ms var(--ease-d);
    visibility: hidden;
  }
  .menu-overlay.open {
    clip-path: inset(0 0 0% 0);
    visibility: visible;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
  }
  .menu-wordmark {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .menu-close {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(244, 243, 239, 0.5);
    font-family: var(--font);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    transition: color var(--dur-s);
  }
  .menu-close:hover { color: rgba(244, 243, 239, 0.9); }

  .menu-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .menu-link {
    font-size: clamp(2.4rem, 7vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: rgba(244, 243, 239, 0.9);
    text-decoration: none;
    display: inline-flex;
    width: fit-content;
  }

  /* per-letter hover — wave stagger, larger lift */
  .menu-link .ch {
    display: inline-block;
    transition: transform 360ms var(--ease-d), opacity 360ms var(--ease-d);
    transition-delay: 0ms;
  }
  .menu-link:hover .ch {
    transform: translateY(-20px);
    opacity: 0.28;
    transition-delay: calc(var(--i) * 22ms);
  }

  .menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 24px;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: rgba(244, 243, 239, 0.35);
  }
  .menu-foot a { color: rgba(244, 243, 239, 0.35); text-decoration: none; transition: color var(--dur-s); }
  .menu-foot a:hover { color: rgba(244, 243, 239, 0.8); }

  @media (max-width: 640px) {
    .menu-link { font-size: clamp(2rem, 12vw, 3.5rem); }
  }
</style>

<script>
  const overlay = document.getElementById('menu-overlay') as HTMLElement | null;
  const openBtn = document.getElementById('menu-open') as HTMLElement | null;
  const closeBtn = document.getElementById('menu-close') as HTMLElement | null;

  const EASE    = 'cubic-bezier(0.22,1,0.36,1)';
  const EASE_IN = 'cubic-bezier(0.64,0,0.78,0)';

  // All animatable elements in order: top-bar → links → footer
  function getAnimEls(): HTMLElement[] {
    if (!overlay) return [];
    const top   = overlay.querySelector<HTMLElement>('.menu-top');
    const links = Array.from(overlay.querySelectorAll<HTMLElement>('.menu-link'));
    const foot  = overlay.querySelector<HTMLElement>('.menu-foot');
    return [top, ...links, foot].filter(Boolean) as HTMLElement[];
  }

  function hideAll() {
    getAnimEls().forEach(el => {
      el.style.transition = 'none';
      el.style.opacity    = '0';
      el.style.transform  = 'translateY(28px)';
    });
  }

  function setMenu(open: boolean) {
    if (!overlay || !openBtn) return;

    if (open) {
      hideAll();
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      // Double rAF: let clip-path animation start, then stagger items in
      requestAnimationFrame(() => requestAnimationFrame(() => {
        getAnimEls().forEach((el, i) => {
          const delay = 90 + i * 65;
          el.style.transition = `opacity 520ms ${EASE} ${delay}ms, transform 520ms ${EASE} ${delay}ms`;
          el.style.opacity    = '1';
          el.style.transform  = 'translateY(0)';
        });
      }));
    } else {
      // Exit: fade up and out quickly
      getAnimEls().forEach(el => {
        el.style.transition = `opacity 200ms ${EASE_IN}, transform 200ms ${EASE_IN}`;
        el.style.opacity    = '0';
        el.style.transform  = 'translateY(-14px)';
      });
      setTimeout(() => {
        overlay.classList.remove('open');
        overlay.setAttribute('aria-hidden', 'true');
        openBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }, 280);
    }
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // scroll state for header
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 10);
  }, { passive: true });

  // split menu links into per-letter spans
  document.querySelectorAll<HTMLElement>('[data-split]').forEach(el => {
    const text = el.textContent || '';
    el.textContent = '';
    el.innerHTML = text.split('').map((c, i) => {
      const ch = c === ' ' ? '&nbsp;' : c;
      return `<span class="ch" style="--i:${i}">${ch}</span>`;
    }).join('');
  });
</script>
