---
import { site } from '../data/site.ts';
import { p } from '../utils/url.ts';
---

<header class="hdr" id="site-header">
  <div class="hdr-inner container">

    <a class="hdr-logo" href={p('/')} aria-label="DANSHARI — Home">
      <span class="hdr-logo-letters">
        DAN<span class="lg-seg">SHA</span><span class="lg-seg">RI</span>
      </span>
      <span class="hdr-logo-ja" aria-hidden="true">断 捨 離</span>
    </a>

    <button class="hdr-menu-btn" id="menu-open" aria-label="Open menu"
            aria-expanded="false" aria-controls="menu-overlay">
      <span class="menu-btn-line"></span>
      <span class="menu-btn-label">MENU</span>
    </button>

  </div>
</header>

<!-- ═══════ Fullscreen menu overlay ═══════ -->
<div class="menu-overlay" id="menu-overlay" aria-hidden="true">
  <div class="menu-top container">
    <span class="menu-wordmark">DANSHARI</span>
    <button class="menu-close" id="menu-close" aria-label="Close menu">CLOSE</button>
  </div>

  <nav class="menu-nav container" aria-label="Fullscreen navigation">
    <a class="menu-link" href={p('/work/')} data-split>WORK</a>
    <a class="menu-link" href={p('/support/')} data-split>SUPPORT</a>
    <a class="menu-link" href={p('/privacy/')} data-split>PRIVACY</a>
    <a class="menu-link" href={p('/contact/')} data-split>CONTACT</a>
  </nav>

  <div class="menu-foot container">
    <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
    <span>TOKYO · JAPAN</span>
  </div>
</div>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 90;
    height: 64px;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-s) var(--ease-d),
                background var(--dur-s) var(--ease-d);
  }

  .hdr.scrolled {
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgba(244, 243, 239, 0.08);
  }

  .hdr-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── logo ── */
  .hdr-logo {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    line-height: 1;
    overflow: hidden;
    color: rgba(244, 243, 239, 0.88);
  }
  .hdr-logo-letters {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    display: flex;
    gap: 0;
    transition: gap var(--dur-m) var(--ease-d);
  }
  .hdr-logo:hover .hdr-logo-letters { gap: 7px; }
  .hdr-logo-ja {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: rgba(244, 243, 239, 0.35);
    transform: translateY(-6px);
    opacity: 0;
    transition: transform var(--dur-m) var(--ease-d), opacity var(--dur-m) var(--ease-d);
    pointer-events: none;
  }
  .hdr-logo:hover .hdr-logo-ja { transform: translateY(0); opacity: 1; }

  /* ── menu button ── */
  .hdr-menu-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(244, 243, 239, 0.9);
    font-family: var(--font);
    padding: 6px 0;
  }
  .menu-btn-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    transition: opacity var(--dur-s) var(--ease-d);
  }
  .menu-btn-line {
    width: 22px;
    height: 1.5px;
    background: rgba(244, 243, 239, 0.9);
    position: relative;
    transition: transform var(--dur-s) var(--ease-d);
  }
  .menu-btn-line::before,
  .menu-btn-line::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: rgba(244, 243, 239, 0.9);
    transition: transform var(--dur-s) var(--ease-d);
  }
  .menu-btn-line::before { top: -6px; }
  .menu-btn-line::after  { top: 6px; }
  .hdr-menu-btn:hover .menu-btn-line { transform: scaleX(0.7); }

  /* ═══ overlay ═══ */
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #0A0A0A;
    color: rgba(244, 243, 239, 0.9);
    display: flex;
    flex-direction: column;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 550ms cubic-bezier(0.22,1,0.36,1);
    visibility: hidden;
  }
  .menu-overlay.open  { clip-path: inset(0 0 0% 0); visibility: visible; }
  .menu-overlay.closing {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 340ms cubic-bezier(0.64,0,0.78,0);
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    opacity: 0;
    transform: translateY(20px);
  }
  .menu-overlay.open .menu-top {
    opacity: 1; transform: none;
    transition: opacity 500ms cubic-bezier(0.22,1,0.36,1) 55ms,
                transform 500ms cubic-bezier(0.22,1,0.36,1) 55ms;
  }
  .menu-overlay.closing .menu-top {
    opacity: 0; transform: translateY(-14px);
    transition: opacity 200ms ease-in, transform 200ms ease-in;
  }

  .menu-wordmark {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    min-width: 6ch; /* prevent layout shift during typewriter */
  }
  .menu-close {
    background: none; border: none; cursor: pointer;
    color: rgba(244, 243, 239, 0.5);
    font-family: var(--font); font-size: 0.7rem;
    font-weight: 700; letter-spacing: 0.14em;
    transition: color var(--dur-s);
  }
  .menu-close:hover { color: rgba(244, 243, 239, 0.9); }

  .menu-nav {
    flex: 1; display: flex; flex-direction: column;
    justify-content: center; gap: 8px;
  }

  /* links hidden by default — stagger in when .open */
  .menu-link {
    font-size: clamp(2.4rem, 7vw, 5.5rem);
    font-weight: 900; letter-spacing: -0.03em; line-height: 1.05;
    color: rgba(244, 243, 239, 0.9);
    text-decoration: none; display: inline-flex; width: fit-content;
    opacity: 0;
    transform: translateY(28px);
  }
  .menu-overlay.open .menu-link {
    opacity: 0.62; transform: none;
    transition: opacity 500ms cubic-bezier(0.22,1,0.36,1),
                transform 500ms cubic-bezier(0.22,1,0.36,1);
  }
  .menu-overlay.open .menu-link:nth-child(1) { transition-delay: 100ms; }
  .menu-overlay.open .menu-link:nth-child(2) { transition-delay: 168ms; }
  .menu-overlay.open .menu-link:nth-child(3) { transition-delay: 236ms; }
  .menu-overlay.open .menu-link:nth-child(4) { transition-delay: 304ms; }
  .menu-overlay.open .menu-link:nth-child(5) { transition-delay: 372ms; }
  .menu-overlay.closing .menu-link {
    opacity: 0; transform: translateY(-14px);
    transition: opacity 200ms ease-in, transform 200ms ease-in;
  }

  /* hover: light up the active link, slightly dim siblings */
  .menu-link:hover {
    opacity: 1;
    transition: opacity 200ms;
  }
  .menu-nav:has(.menu-link:hover) .menu-link:not(:hover) {
    opacity: 0.32;
    transition: opacity 280ms;
  }

  /* per-letter wave lift on hover */
  .menu-link .ch {
    display: inline-block;
    will-change: transform, opacity;
    transition: transform 380ms cubic-bezier(0.22,1,0.36,1), opacity 380ms;
    transition-delay: 0ms;
  }
  .menu-link:hover .ch {
    transform: translateY(-22px);
    opacity: 0.18;
    transition-delay: calc(var(--i) * 20ms);
  }

  .menu-foot {
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 24px;
    font-size: 0.68rem; letter-spacing: 0.08em;
    color: rgba(244, 243, 239, 0.35);
    opacity: 0; transform: translateY(20px);
  }
  .menu-overlay.open .menu-foot {
    opacity: 1; transform: none;
    transition: opacity 500ms cubic-bezier(0.22,1,0.36,1) 442ms,
                transform 500ms cubic-bezier(0.22,1,0.36,1) 442ms;
  }
  .menu-overlay.closing .menu-foot {
    opacity: 0; transform: translateY(-14px);
    transition: opacity 200ms ease-in, transform 200ms ease-in;
  }
  .menu-foot a { color: rgba(244, 243, 239, 0.35); text-decoration: none; transition: color var(--dur-s); }
  .menu-foot a:hover { color: rgba(244, 243, 239, 0.8); }

  @media (max-width: 640px) {
    .menu-link { font-size: clamp(2rem, 12vw, 3.5rem); }
  }
</style>

<script>
  const overlay  = document.getElementById('menu-overlay') as HTMLElement | null;
  const openBtn  = document.getElementById('menu-open')   as HTMLElement | null;
  const closeBtn = document.getElementById('menu-close')  as HTMLElement | null;
  const wordmark = overlay?.querySelector<HTMLElement>('.menu-wordmark');

  // Typewriter for the menu wordmark
  const BRAND = 'DANSHARI';
  let twTimer: ReturnType<typeof setTimeout> | null = null;
  let twInterval: ReturnType<typeof setInterval> | null = null;

  function startType() {
    if (!wordmark) return;
    wordmark.textContent = '';
    let i = 0;
    twTimer = setTimeout(() => {
      twInterval = setInterval(() => {
        wordmark.textContent += BRAND[i++];
        if (i >= BRAND.length) { clearInterval(twInterval!); twInterval = null; }
      }, 52);
    }, 70);
  }

  function stopType() {
    if (twTimer) { clearTimeout(twTimer); twTimer = null; }
    if (twInterval) { clearInterval(twInterval!); twInterval = null; }
    if (wordmark) wordmark.textContent = BRAND;
  }

  function setMenu(open: boolean) {
    if (!overlay || !openBtn) return;
    if (open) {
      overlay.classList.remove('closing');
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      startType();
    } else {
      stopType();
      overlay.classList.add('closing');
      setTimeout(() => {
        overlay.classList.remove('open', 'closing');
        overlay.setAttribute('aria-hidden', 'true');
        openBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }, 280);
    }
  }

  openBtn?.addEventListener('click',  () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 10);
  }, { passive: true });

  document.querySelectorAll<HTMLElement>('[data-split]').forEach(el => {
    const text = el.textContent || '';
    el.textContent = '';
    el.innerHTML = text.split('').map((c, i) =>
      `<span class="ch" style="--i:${i}">${c === ' ' ? '&nbsp;' : c}</span>`
    ).join('');
  });
</script>
